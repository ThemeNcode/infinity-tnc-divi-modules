# Treat these as binary so git never applies text/EOL/encoding conversion.
# Prevents font/image corruption (the U+FFFD replacement-byte issue).

# Fonts
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.eot    binary

# Images
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary

# Other binaries
*.zip    binary
*.pdf    binary
*.mp4    binary
