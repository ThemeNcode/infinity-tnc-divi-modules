{
  "name": "inftnc/youtube-embed",
  "d4Shortcode": "inftnc_youtube_embed",
  "title": "Youtube Video - Infinity TNC",
  "titles": "Youtube Videos",
  "moduleIcon": "inftnc/module-youtube-embed",
  "moduleClassName": "inftnc_youtube_video",
  "moduleOrderClassName": "inftnc_youtube_video_container",
  "category": "module",
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "meta": {
          "adminLabel": {
            "desktop": {
              "value": "Youtube Video"
            }
          }
        }
      },
      "settings": {
        "meta": {
          "adminLabel": {}
        },
        "advanced": {
          "link": {},
          "htmlAttributes": {}
        },
        "decoration": {
          "background": {},
          "sizing": {
            "css": {
              "main": "{{selector}}",
              "height": "{{selector}} .inftnc_youtube_video_container iframe !important",
              "min_height": "{{selector}} .inftnc_youtube_video_container iframe !important",
              "max_height": "{{selector}} .inftnc_youtube_video_container iframe !important",
              "min-height": "{{selector}} .inftnc_youtube_video_container iframe !important",
              "max-height": "{{selector}} .inftnc_youtube_video_container iframe !important"
            }
          },
          "spacing": {},
          "border": {},
          "boxShadow": {},
          "transform": {},
          "animation": {},
          "overflow": {},
          "disabledOn": {},
          "transition": {},
          "position": {},
          "zIndex": {},
          "scroll": {},
          "sticky": {}
        }
      }
    },
    "youtubeEmbedData": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "innerContent": {
          "desktop": {
            "value": {
              "video_type": "video",
              "video_method": "video_url",
              "youtube_url": "https://www.youtube.com/watch?v=z8uxAkjll5g",
              "youtube_id": "",
              "youtube_embed": "",
              "video_start": "0",
              "video_end": "0",
              "autoplay": "on",
              "mute": "off",
              "loop": "off",
              "player_control": "off",
              "video_rel": "off"
            }
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "video_type": {
              "groupSlug": "contentYoutubeEmbed",
              "attrName": "youtubeEmbedData.innerContent",
              "subName": "video_type",
              "label": "Video Type",
              "description": "Select the type of video content.",
              "priority": 10,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "name": "divi/select",
                "props": {
                  "options": {
                    "video": { "label": "Video" },
                    "playlist": { "label": "Playlist" }
                  }
                },
                "type": "field"
              }
            },
            "video_method": {
              "groupSlug": "contentYoutubeEmbed",
              "attrName": "youtubeEmbedData.innerContent",
              "subName": "video_method",
              "label": "Video/Playlist Method",
              "description": "Select how you want to add the video content.",
              "priority": 20,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "name": "divi/select",
                "props": {
                  "options": {
                    "video_url": { "label": "URL" },
                    "video_id": { "label": "ID" },
                    "embed_code": { "label": "Embed Code" }
                  }
                },
                "type": "field"
              }
            },
            "youtube_url": {
              "groupSlug": "contentYoutubeEmbed",
              "attrName": "youtubeEmbedData.innerContent",
              "subName": "youtube_url",
              "label": "Youtube Video/Playlist URL",
              "description": "Enter the URL of the YouTube video or playlist.",
              "priority": 30,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "name": "divi/text",
                "type": "field"
              }
            },
            "youtube_id": {
              "groupSlug": "contentYoutubeEmbed",
              "attrName": "youtubeEmbedData.innerContent",
              "subName": "youtube_id",
              "label": "Youtube Video/Playlist ID",
              "description": "Enter the ID of the YouTube video or playlist.",
              "priority": 40,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "name": "divi/text",
                "type": "field"
              }
            },
            "youtube_embed": {
              "groupSlug": "contentYoutubeEmbed",
              "attrName": "youtubeEmbedData.innerContent",
              "subName": "youtube_embed",
              "label": "Youtube Video/Playlist Embed Code",
              "description": "Enter the embed code of the YouTube video or playlist.",
              "priority": 50,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "name": "divi/textarea",
                "type": "field"
              }
            },
            "video_start": {
              "groupSlug": "videoOptionsYoutubeEmbed",
              "attrName": "youtubeEmbedData.innerContent",
              "subName": "video_start",
              "label": "Start Time (seconds)",
              "description": "Specify a start time in seconds.",
              "priority": 60,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "name": "divi/range",
                "props": {
                  "min": 0,
                  "max": 1000,
                  "step": 1,
                  "allowedUnits": [""],
                  "defaultUnit": ""
                },
                "type": "field"
              }
            },
            "video_end": {
              "groupSlug": "videoOptionsYoutubeEmbed",
              "attrName": "youtubeEmbedData.innerContent",
              "subName": "video_end",
              "label": "End Time (seconds)",
              "description": "Specify an end time in seconds.",
              "priority": 70,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "name": "divi/range",
                "props": {
                  "min": 0,
                  "max": 1000,
                  "step": 1,
                  "allowedUnits": [""],
                  "defaultUnit": ""
                },
                "type": "field"
              }
            },
            "autoplay": {
              "groupSlug": "videoOptionsYoutubeEmbed",
              "attrName": "youtubeEmbedData.innerContent",
              "subName": "autoplay",
              "label": "Autoplay",
              "description": "Automatically start playback of the video.",
              "priority": 80,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "name": "divi/toggle",
                "type": "field"
              }
            },
            "mute": {
              "groupSlug": "videoOptionsYoutubeEmbed",
              "attrName": "youtubeEmbedData.innerContent",
              "subName": "mute",
              "label": "Mute",
              "description": "Set video to mute on load.",
              "priority": 90,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "name": "divi/toggle",
                "type": "field"
              }
            },
            "loop": {
              "groupSlug": "videoOptionsYoutubeEmbed",
              "attrName": "youtubeEmbedData.innerContent",
              "subName": "loop",
              "label": "Loop",
              "description": "Play the video again when it reaches the end.",
              "priority": 100,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "name": "divi/toggle",
                "type": "field"
              }
            },
            "player_control": {
              "groupSlug": "videoOptionsYoutubeEmbed",
              "attrName": "youtubeEmbedData.innerContent",
              "subName": "player_control",
              "label": "Player Controls",
              "description": "Show/Hide player controls.",
              "priority": 110,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "name": "divi/toggle",
                "type": "field"
              }
            },
            "video_rel": {
              "groupSlug": "videoOptionsYoutubeEmbed",
              "attrName": "youtubeEmbedData.innerContent",
              "subName": "video_rel",
              "label": "Suggested Videos",
              "description": "Show suggested videos from other channels when playback ends.",
              "priority": 120,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "name": "divi/toggle",
                "type": "field"
              }
            }
          }
        }
      }
    }
  },
  "customCssFields": {
    "iframe": {
      "subName": "iframe",
      "selectorSuffix": " .inftnc_youtube_video_container iframe"
    }
  },
  "settings": {
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentYoutubeEmbed": {
        "panel": "content",
        "priority": 10,
        "groupName": "contentYoutubeEmbed",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Youtube Video"
          }
        }
      },
      "videoOptionsYoutubeEmbed": {
        "panel": "content",
        "priority": 20,
        "groupName": "videoOptionsYoutubeEmbed",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Video Options"
          }
        }
      }
    }
  }
}
