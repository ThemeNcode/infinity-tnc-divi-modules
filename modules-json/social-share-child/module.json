{
  "name": "inftnc/social-share-child",
  "d4Shortcode": "inftnc_social_share_child",
  "title": "Social Network",
  "titles": "Social Networks",
  "moduleIcon": "divi/social-media-follow-network",
  "category": "child-module",
  "moduleClassName": "inftnc_social_share_child",
  "moduleOrderClassName": "inftnc_social_share_child",
  "childrenName": [],
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "meta": {
          "adminLabel": {
            "desktop": {
              "value": "Social Network"
            }
          }
        }
      },
      "settings": {
        "advanced": {
          "htmlAttributes": {}
        },
        "decoration": {
          "background": {},
          "spacing": {},
          "border": {},
          "boxShadow": {},
          "transform": {},
          "animation": {},
          "disabledOn": {},
          "transition": {}
        }
      }
    },
    "buttonText": {
      "type": "object",
      "selector": ".inftnc_social_share {{selector}} .inftnc_social_text",
      "styleProps": {
        "font": {
          "important": true
        }
      },
      "settings": {
        "decoration": {
          "font": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designButtonText",
              "attrName": "buttonText.decoration.font",
              "priority": 10,
              "render": true,
              "component": {
                "name": "divi/font",
                "type": "group",
                "props": {
                  "grouped": false,
                  "fieldLabel": "Button Text",
                  "fields": {
                    "headingLevel": { "render": false }
                  }
                }
              }
            }
          }
        }
      }
    },
    "socialShareChildData": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "innerContent": {
          "desktop": {
            "value": {
              "social_share": "facebook",
              "button_color_child": "",
              "button_padding_child_top": "",
              "button_padding_child_right": "",
              "button_padding_child_bottom": "",
              "button_padding_child_left": "",
              "button_padding_child": "",
              "icon_color_child": "",
              "icon_size_child": ""
            }
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "social_share": {
              "groupSlug": "contentNetwork",
              "attrName": "socialShareChildData.innerContent",
              "subName": "social_share",
              "label": "Social Network",
              "description": "Choose the social network.",
              "priority": 10,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": {
                "name": "divi/select",
                "type": "field",
                "props": {
                  "options": {
                    "facebook":  { "label": "Facebook" },
                    "whatsapp":  { "label": "WhatsApp" },
                    "twitter":   { "label": "X (Twitter)" },
                    "pinterest": { "label": "Pinterest" },
                    "linekdin":  { "label": "LinkedIn" },
                    "telegram":  { "label": "Telegram" },
                    "reddit":    { "label": "Reddit" },
                    "tumblr":    { "label": "Tumblr" },
                    "email":     { "label": "Email" },
                    "blogger":   { "label": "Blogger" }
                  }
                }
              }
            },
            "button_color_child": {
              "groupSlug": "designShareButton",
              "attrName": "socialShareChildData.innerContent",
              "subName": "button_color_child",
              "label": "Button Background Color",
              "priority": 10,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": { "name": "divi/color-picker", "type": "field" }
            },
            "button_padding_child_top": {
              "groupSlug": "designShareButton",
              "attrName": "socialShareChildData.innerContent",
              "subName": "button_padding_child_top",
              "label": "Padding Top",
              "priority": 20,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": {
                "name": "divi/range",
                "type": "field",
                "props": { "min": 0, "max": 200, "allowedUnits": ["px", "em", "rem", "%"] }
              }
            },
            "button_padding_child_right": {
              "groupSlug": "designShareButton",
              "attrName": "socialShareChildData.innerContent",
              "subName": "button_padding_child_right",
              "label": "Padding Right",
              "priority": 21,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": {
                "name": "divi/range",
                "type": "field",
                "props": { "min": 0, "max": 200, "allowedUnits": ["px", "em", "rem", "%"] }
              }
            },
            "button_padding_child_bottom": {
              "groupSlug": "designShareButton",
              "attrName": "socialShareChildData.innerContent",
              "subName": "button_padding_child_bottom",
              "label": "Padding Bottom",
              "priority": 22,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": {
                "name": "divi/range",
                "type": "field",
                "props": { "min": 0, "max": 200, "allowedUnits": ["px", "em", "rem", "%"] }
              }
            },
            "button_padding_child_left": {
              "groupSlug": "designShareButton",
              "attrName": "socialShareChildData.innerContent",
              "subName": "button_padding_child_left",
              "label": "Padding Left",
              "priority": 23,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": {
                "name": "divi/range",
                "type": "field",
                "props": { "min": 0, "max": 200, "allowedUnits": ["px", "em", "rem", "%"] }
              }
            },
            "icon_color_child": {
              "groupSlug": "designShareIcon",
              "attrName": "socialShareChildData.innerContent",
              "subName": "icon_color_child",
              "label": "Icon Color",
              "priority": 10,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": { "name": "divi/color-picker", "type": "field" }
            },
            "icon_size_child": {
              "groupSlug": "designShareIcon",
              "attrName": "socialShareChildData.innerContent",
              "subName": "icon_size_child",
              "label": "Icon Size",
              "priority": 20,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": {
                "name": "divi/range",
                "type": "field",
                "props": { "min": 0, "max": 100, "allowedUnits": ["px"] }
              }
            }
          }
        }
      }
    }
  },
  "customCssFields": {
    "share_link": {
      "label": "Share Link",
      "subName": "share_link",
      "selectorSuffix": " .inftnc_share_link"
    },
    "social_icon": {
      "label": "Social Icon",
      "subName": "social_icon",
      "selectorSuffix": " .inftnc_social_icon"
    },
    "social_text": {
      "label": "Social Text",
      "subName": "social_text",
      "selectorSuffix": " .inftnc_social_text"
    }
  },
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentNetwork": {
        "panel": "content",
        "priority": 10,
        "groupName": "contentNetwork",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": { "groupLabel": "Network" }
        }
      },
      "designButtonText": {
        "panel": "design",
        "priority": 10,
        "groupName": "designButtonText",
        "component": {
          "name": "divi/composite",
          "props": { "groupLabel": "Button Text", "presetGroup": "divi/font" }
        }
      },
      "designShareButton": {
        "panel": "design",
        "priority": 20,
        "groupName": "designShareButton",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": { "groupLabel": "Share Button" }
        }
      },
      "designShareIcon": {
        "panel": "design",
        "priority": 30,
        "groupName": "designShareIcon",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": { "groupLabel": "Share Icon" }
        }
      }
    }
  }
}
