{
  "name": "inftnc/star-rating",
  "d4Shortcode": "inftnc_star_rating",
  "title": "Star Rating - Infinity TNC",
  "titles": "Star Ratings",
  "moduleIcon": "divi/content",
  "moduleClassName": "inftnc_star_rating",
  "moduleOrderClassName": "inftnc_star_rating_wrapper",
  "category": "module",
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "meta": {
          "adminLabel": {
            "desktop": {
              "value": "Star Rating"
            }
          }
        }
      },
      "settings": {
        "meta": {
          "adminLabel": {}
        },
        "advanced": {
          "link": {},
          "htmlAttributes": {},
          "header": {
            "title": {
              "css": {
                "main": "{{selector}} h1.inftnc_rating_title, {{selector}} h2.inftnc_rating_title, {{selector}} h3.inftnc_rating_title, {{selector}} h4.inftnc_rating_title, {{selector}} h5.inftnc_rating_title, {{selector}} h6.inftnc_rating_title"
              },
              "font_size": { "default": "30px" },
              "line_height": { "default": "1em" },
              "letter_spacing": { "default": "0px" },
              "header_level": { "default": "h1" }
            }
          }
        },
        "decoration": {
          "background": {},
          "sizing": {},
          "spacing": {},
          "border": {},
          "boxShadow": {},
          "transform": {},
          "animation": {},
          "overflow": {},
          "disabledOn": {},
          "transition": {},
          "position": {},
          "zIndex": {},
          "scroll": {},
          "sticky": {}
        }
      }
    },
    "ratingNumber": {
      "type": "object",
      "label": "Rating Number Text",
      "selector": "{{selector}} .inftnc_star_rating_number",
      "default": {
        "decoration": {
          "font": {
            "font": {
              "desktop": {
                "value": {
                  "size": "30px",
                  "lineHeight": "1em"
                }
              }
            }
          }
        }
      },
      "settings": {
        "decoration": {
          "font": {}
        }
      }
    },
    "starRatingData": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "innerContent": {
          "desktop": {
            "value": {
              "title": "",
              "count_star": "5",
              "rating": "5",
              "show_rating_number": "off",
              "icon_color": "#EBC03F",
              "empty_color": "#AAAAAA",
              "star_size": "25",
              "gap": "0",
              "star_alignment": "left"
            }
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "title": {
              "groupSlug": "contentStarRating",
              "attrName": "starRatingData.innerContent",
              "subName": "title",
              "label": "Title",
              "description": "Text displayed above the star rating.",
              "priority": 10,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": { "name": "divi/text", "type": "field" }
            },
            "count_star": {
              "groupSlug": "contentStarRating",
              "attrName": "starRatingData.innerContent",
              "subName": "count_star",
              "label": "Rating Scale",
              "description": "Total number of stars (rating scale).",
              "priority": 20,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": {
                "name": "divi/range",
                "type": "field",
                "props": { "min": 1, "max": 10, "step": 1, "defaultUnit": "" }
              }
            },
            "rating": {
              "groupSlug": "contentStarRating",
              "attrName": "starRatingData.innerContent",
              "subName": "rating",
              "label": "Rating Value",
              "description": "The current rating value.",
              "priority": 30,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": {
                "name": "divi/range",
                "type": "field",
                "props": { "min": 0, "max": 10, "step": 0.5, "defaultUnit": "" }
              }
            },
            "show_rating_number": {
              "groupSlug": "contentStarRating",
              "attrName": "starRatingData.innerContent",
              "subName": "show_rating_number",
              "label": "Display Rating Value Text",
              "description": "Show or hide the numeric rating value.",
              "priority": 40,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": {
                "name": "divi/toggle",
                "type": "field",
                "props": {
                  "options": {
                    "off": { "label": "Hide" },
                    "on":  { "label": "Show" }
                  }
                }
              }
            },
            "icon_color": {
              "groupSlug": "designStarStyle",
              "attrName": "starRatingData.innerContent",
              "subName": "icon_color",
              "label": "Star Icon Color",
              "priority": 10,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": { "name": "divi/color-picker", "type": "field" }
            },
            "empty_color": {
              "groupSlug": "designStarStyle",
              "attrName": "starRatingData.innerContent",
              "subName": "empty_color",
              "label": "Star Empty Color",
              "priority": 20,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": { "name": "divi/color-picker", "type": "field" }
            },
            "star_size": {
              "groupSlug": "designStarStyle",
              "attrName": "starRatingData.innerContent",
              "subName": "star_size",
              "label": "Star Size",
              "priority": 30,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": {
                "name": "divi/range",
                "type": "field",
                "props": { "min": 10, "max": 150, "step": 1, "defaultUnit": "" }
              }
            },
            "gap": {
              "groupSlug": "designStarStyle",
              "attrName": "starRatingData.innerContent",
              "subName": "gap",
              "label": "Star Gap",
              "priority": 40,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": {
                "name": "divi/range",
                "type": "field",
                "props": { "min": 0, "max": 100, "step": 1, "defaultUnit": "" }
              }
            },
            "star_alignment": {
              "groupSlug": "designStarStyle",
              "attrName": "starRatingData.innerContent",
              "subName": "star_alignment",
              "label": "Star Alignment",
              "priority": 50,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": {
                "name": "divi/select",
                "type": "field",
                "props": {
                  "options": {
                    "left":   { "label": "Left" },
                    "center": { "label": "Center" },
                    "right":  { "label": "Right" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "customCssFields": {
    "star_wrapper": {
      "subName": "star_wrapper",
      "selectorSuffix": " .inftnc_rating_inner_wrapper"
    },
    "rating_title": {
      "subName": "rating_title",
      "selectorSuffix": " .inftnc_rating_title"
    },
    "rating_number": {
      "subName": "rating_number",
      "selectorSuffix": " .inftnc_star_rating_number"
    }
  },
  "settings": {
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentStarRating": {
        "panel": "content",
        "priority": 10,
        "groupName": "contentStarRating",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": { "groupLabel": "Rating" }
        }
      },
      "designStarStyle": {
        "panel": "design",
        "priority": 10,
        "groupName": "designStarStyle",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": { "groupLabel": "Star Style" }
        }
      }
    }
  }
}
