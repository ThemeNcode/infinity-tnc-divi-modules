    "sourceData": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "innerContent": {
          "desktop": {
            "value": {
              "sourceType": "latitude_longitude",
              "latitudeLongitude": "40.658620799731196,-73.99475680760217",
              "mapZoom": "14",
              "embedCode": ""
            }
          }
        }
      },
      "settings": {
        "innerContent": {
