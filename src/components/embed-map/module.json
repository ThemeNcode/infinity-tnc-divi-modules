              "subName": "sourceType",
              "label": "Source Type",
              "description": "Choose how to embed the map.",
              "priority": 10,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "name": "divi/select",
                "type": "field",
                "props": {
                  "options": {
                    "latitude_longitude": {
                      "label": "Latitude & Longitude"
                    },
                    "emebed_code": {
                      "label": "Embed Code"
                    }
                  }
                }
              }
            },
            "latitudeLongitude": {
              "groupSlug": "contentEmbedMap",
              "attrName": "sourceData.innerContent",
              "subName": "latitudeLongitude",
              "label": "Latitude & Longitude",
              "description": "Map Latitude & Longitude",
              "priority": 20,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "name": "divi/text",
                "type": "field"
              }
            },
            "mapZoom": {
              "groupSlug": "contentEmbedMap",
              "attrName": "sourceData.innerContent",
              "subName": "mapZoom",
              "label": "Zoom",
              "description": "Map zoom level.",
              "priority": 30,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "name": "divi/range",
                "type": "field",
                "props": {
                  "min": 1,
                  "max": 100,
                  "step": 1
                }
              }
            },
            "embedCode": {
              "groupSlug": "contentEmbedMap",
              "attrName": "sourceData.innerContent",
              "subName": "embedCode",
              "label": "Embed Code",
              "description": "Paste your map embed code here.",
              "priority": 40,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "name": "divi/textarea",
                "type": "field"
              }
            }
