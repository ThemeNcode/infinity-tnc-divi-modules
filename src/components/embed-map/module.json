  "settings": {
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentEmbedMap": {
        "panel": "content",
        "priority": 10,
        "groupName": "embedMap",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Embed Map"
          }
        }
      }
    }
