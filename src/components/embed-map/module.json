            }
          }
        }
      },
      "settings": {
        "meta": {
          "adminLabel": {}
        },
        "advanced": {
          "link": {},
          "htmlAttributes": {}
        },
        "decoration": {
          "background": {},
          "sizing": {
            "css": {
              "main": "{{selector}}",
              "height": "{{selector}} .inftnc_embed_map iframe !important",
              "min_height": "{{selector}} .inftnc_embed_map iframe !important",
              "max_height": "{{selector}} .inftnc_embed_map iframe !important",
