{
  "name": "inftnc/heading-gradient",
  "d4Shortcode": "inftnc_heading_gradient",
  "title": "Heading Gradient - Infinity TNC",
  "titles": "Heading Gradients",
  "moduleIcon": "divi/content",
  "moduleClassName": "inftnc_heading_gradient",
  "moduleOrderClassName": "inftnc_heading_gradient_container",
  "category": "module",
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "meta": {
          "adminLabel": {
            "desktop": {
              "value": "Heading Gradient"
            }
          }
        }
      },
      "settings": {
        "meta": {
          "adminLabel": {}
        },
        "advanced": {
          "link": {},
          "htmlAttributes": {},
          "header": {
            "title": {
              "css": {
                "main": "{{selector}} h1.inftnc_gradient_title, {{selector}} h2.inftnc_gradient_title, {{selector}} h3.inftnc_gradient_title, {{selector}} h4.inftnc_gradient_title, {{selector}} h5.inftnc_gradient_title, {{selector}} h6.inftnc_gradient_title"
              },
              "font_size": { "default": "30px" },
              "line_height": { "default": "1em" },
              "letter_spacing": { "default": "0px" },
              "header_level": { "default": "h1" }
            }
          }
        },
        "decoration": {
          "background": {},
          "sizing": {},
          "spacing": {},
          "border": {},
          "boxShadow": {},
          "transform": {},
          "animation": {},
          "overflow": {},
          "disabledOn": {},
          "transition": {},
          "position": {},
          "zIndex": {},
          "scroll": {},
          "sticky": {}
        }
      }
    },
    "title": {
      "type": "object",
      "selector": "{{selector}} .inftnc_gradient_title",
      "default": {
        "decoration": {
          "font": {
            "font": {
              "desktop": {
                "value": {
                  "headingLevel": "h1"
                }
              }
            }
          }
        }
      },
      "inlineEditor": "plainText",
      "elementType": "heading",
      "childrenSanitizer": "et_core_esc_previously",
      "settings": {
        "decoration": {
          "font": {}
        }
      }
    },
    "headingGradientData": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "innerContent": {
          "desktop": {
            "value": {
              "gradient_title": "My Awesome Heading with Gradient",
              "gradient_options": "gradient_custom_color",
              "gradient_type": "linear_gradient",
              "linear_position": "right",
              "radial_position": "center center",
              "ellipse_position": "center center",
              "start_color": "#481CA6",
              "end_color": "#AC43D9",
              "start_position": 0,
              "end_position": 100,
              "presets_gradient": "gradient_preset1"
            }
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "gradient_title": {
              "groupSlug": "contentHeadingGradient",
              "attrName": "headingGradientData.innerContent",
              "subName": "gradient_title",
              "label": "Heading Text",
              "description": "Content entered here will appear inside the module.",
              "priority": 10,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": { "name": "divi/text", "type": "field" }
            },
            "gradient_options": {
              "groupSlug": "gradientStyleHeadingGradient",
              "attrName": "headingGradientData.innerContent",
              "subName": "gradient_options",
              "label": "Gradient Options",
              "priority": 10,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": {
                "name": "divi/select",
                "props": {
                  "options": {
                    "gradient_preset_color": { "label": "Gradient Preset" },
                    "gradient_custom_color": { "label": "Custom Color" }
                  }
                },
                "type": "field"
              }
            },
            "presets_gradient": {
              "groupSlug": "gradientStyleHeadingGradient",
              "attrName": "headingGradientData.innerContent",
              "subName": "presets_gradient",
              "label": "Presets Gradient Style",
              "priority": 20,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": {
                "name": "divi/select",
                "props": {
                  "options": {
                    "gradient_preset1": { "label": "Preset 1" },
                    "gradient_preset2": { "label": "Preset 2" },
                    "gradient_preset3": { "label": "Preset 3" },
                    "gradient_preset4": { "label": "Preset 4" },
                    "gradient_preset5": { "label": "Preset 5" },
                    "gradient_preset6": { "label": "Preset 6" }
                  }
                },
                "type": "field"
              }
            },
            "gradient_type": {
              "groupSlug": "gradientStyleHeadingGradient",
              "attrName": "headingGradientData.innerContent",
              "subName": "gradient_type",
              "label": "Gradient Type",
              "priority": 30,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": {
                "name": "divi/select",
                "props": {
                  "options": {
                    "linear_gradient": { "label": "Linear Gradient" },
                    "radial_gradient": { "label": "Radial Gradient" },
                    "ellipse": { "label": "Elliptical" }
                  }
                },
                "type": "field"
              }
            },
            "linear_position": {
              "groupSlug": "gradientStyleHeadingGradient",
              "attrName": "headingGradientData.innerContent",
              "subName": "linear_position",
              "label": "Linear Position",
              "priority": 40,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": {
                "name": "divi/select",
                "props": {
                  "options": {
                    "top left": { "label": "Top Left" },
                    "top_left": { "label": "Top Left" },
                    "top": { "label": "Top" },
                    "top right": { "label": "Top Right" },
                    "top_right": { "label": "Top Right" },
                    "right": { "label": "Right" },
                    "bottom right": { "label": "Bottom Right" },
                    "bottom_right": { "label": "Bottom Right" },
                    "bottom": { "label": "Bottom" },
                    "bottom left": { "label": "Bottom Left" },
                    "bottom_left": { "label": "Bottom Left" },
                    "left": { "label": "Left" }
                  }
                },
                "type": "field"
              }
            },
            "radial_position": {
              "groupSlug": "gradientStyleHeadingGradient",
              "attrName": "headingGradientData.innerContent",
              "subName": "radial_position",
              "label": "Radial Position",
              "priority": 50,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": {
                "name": "divi/select",
                "props": {
                  "options": {
                    "top left": { "label": "Top Left" },
                    "top_left": { "label": "Top Left" },
                    "top center": { "label": "Top Center" },
                    "top_center": { "label": "Top Center" },
                    "top right": { "label": "Top Right" },
                    "top_right": { "label": "Top Right" },
                    "left center": { "label": "Left Center" },
                    "left_center": { "label": "Left Center" },
                    "center center": { "label": "Center Center" },
                    "center_center": { "label": "Center Center" },
                    "right center": { "label": "Right Center" },
                    "right_center": { "label": "Right Center" },
                    "bottom left": { "label": "Bottom Left" },
                    "bottom_left": { "label": "Bottom Left" },
                    "bottom right": { "label": "Bottom Right" },
                    "bottom_right": { "label": "Bottom Right" }
                  }
                },
                "type": "field"
              }
            },
            "ellipse_position": {
              "groupSlug": "gradientStyleHeadingGradient",
              "attrName": "headingGradientData.innerContent",
              "subName": "ellipse_position",
              "label": "Ellipse Position",
              "priority": 60,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": {
                "name": "divi/select",
                "props": {
                  "options": {
                    "top left": { "label": "Top Left" },
                    "top_left": { "label": "Top Left" },
                    "top center": { "label": "Top Center" },
                    "top_center": { "label": "Top Center" },
                    "top right": { "label": "Top Right" },
                    "top_right": { "label": "Top Right" },
                    "left center": { "label": "Left Center" },
                    "left_center": { "label": "Left Center" },
                    "center center": { "label": "Center Center" },
                    "center_center": { "label": "Center Center" },
                    "right center": { "label": "Right Center" },
                    "right_center": { "label": "Right Center" },
                    "bottom left": { "label": "Bottom Left" },
                    "bottom_left": { "label": "Bottom Left" },
                    "bottom center": { "label": "Bottom Center" },
                    "bottom_center": { "label": "Bottom Center" },
                    "bottom right": { "label": "Bottom Right" },
                    "bottom_right": { "label": "Bottom Right" }
                  }
                },
                "type": "field"
              }
            },
            "start_color": {
              "groupSlug": "gradientStyleHeadingGradient",
              "attrName": "headingGradientData.innerContent",
              "subName": "start_color",
              "label": "Start Color",
              "priority": 70,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": { "name": "divi/color-picker", "type": "field" }
            },
            "end_color": {
              "groupSlug": "gradientStyleHeadingGradient",
              "attrName": "headingGradientData.innerContent",
              "subName": "end_color",
              "label": "End Color",
              "priority": 80,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": { "name": "divi/color-picker", "type": "field" }
            },
            "start_position": {
              "groupSlug": "gradientStyleHeadingGradient",
              "attrName": "headingGradientData.innerContent",
              "subName": "start_position",
              "label": "Start Position",
              "priority": 90,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": {
                "name": "divi/range",
                "props": { "min": 0, "max": 100, "step": 1, "defaultUnit": "" },
                "type": "field"
              }
            },
            "end_position": {
              "groupSlug": "gradientStyleHeadingGradient",
              "attrName": "headingGradientData.innerContent",
              "subName": "end_position",
              "label": "End Position",
              "priority": 100,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": {
                "name": "divi/range",
                "props": { "min": 0, "max": 100, "step": 1, "defaultUnit": "" },
                "type": "field"
              }
            }
          }
        }
      }
    }
  },
  "customCssFields": {
    "title": {
      "subName": "title",
      "selectorSuffix": " .inftnc_gradient_title"
    }
  },
  "settings": {
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentHeadingGradient": {
        "panel": "content",
        "priority": 10,
        "groupName": "contentHeadingGradient",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": { "groupLabel": "Heading" }
        }
      },
      "gradientStyleHeadingGradient": {
        "panel": "content",
        "priority": 20,
        "groupName": "gradientStyleHeadingGradient",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": { "groupLabel": "Gradient Style" }
        }
      }
    }
  }
}