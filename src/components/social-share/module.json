{
  "name": "inftnc/social-share",
  "d4Shortcode": "inftnc_social_share",
  "title": "Social Share - Infinity TNC",
  "titles": "Social Share",
  "moduleIcon": "divi/social-media-follow",
  "moduleClassName": "inftnc_social_share",
  "moduleOrderClassName": "inftnc_social_share",
  "category": "module",
  "childModuleName": "inftnc/social-share-child",
  "childModuleTitle": "Social Network",
  "childrenName": [
    "inftnc/social-share-child"
  ],
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "meta": {
          "adminLabel": {
            "desktop": {
              "value": "Social Share"
            }
          }
        }
      },
      "settings": {
        "meta": {
          "adminLabel": {}
        },
        "advanced": {
          "link": {},
          "htmlAttributes": {}
        },
        "decoration": {
          "background": {},
          "sizing": {},
          "spacing": {},
          "border": {},
          "boxShadow": {},
          "transform": {},
          "animation": {},
          "overflow": {},
          "disabledOn": {},
          "transition": {},
          "position": {},
          "zIndex": {},
          "scroll": {},
          "sticky": {}
        }
      }
    },
    "buttonText": {
      "type": "object",
      "selector": "{{selector}} .inftnc_social_text",
      "styleProps": {
        "font": {
          "important": true
        }
      },
      "settings": {
        "decoration": {
          "font": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designButtonText",
              "attrName": "buttonText.decoration.font",
              "priority": 10,
              "render": true,
              "component": {
                "name": "divi/font",
                "type": "group",
                "props": {
                  "grouped": false,
                  "fieldLabel": "Button Text",
                  "fields": {
                    "headingLevel": {
                      "render": false
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "socialShareData": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "innerContent": {
          "desktop": {
            "value": {
              "button_layout": "icon_with_text",
              "button_shape": "button_square",
              "columns": "column_auto",
              "columns_gap": "10px",
              "row_gap": "10px",
              "button_bg": "",
              "icon_color": "",
              "icon_size": "16px",
              "button_padding": {
                "padding": {
                  "top": "10px",
                  "right": "24px",
                  "bottom": "10px",
                  "left": "24px"
                }
              }
            }
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "button_layout": {
              "groupSlug": "contentLayout",
              "attrName": "socialShareData.innerContent",
              "subName": "button_layout",
              "label": "Button Style",
              "description": "Choose the button layout style.",
              "priority": 10,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "name": "divi/select",
                "type": "field",
                "props": {
                  "options": {
                    "icon_with_text": { "label": "Icon with Text" },
                    "only_icon":      { "label": "Only Icon" },
                    "only_text":      { "label": "Only Text" }
                  }
                }
              }
            },
            "button_shape": {
              "groupSlug": "contentLayout",
              "attrName": "socialShareData.innerContent",
              "subName": "button_shape",
              "label": "Button Shape",
              "description": "Choose the button shape.",
              "priority": 20,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "name": "divi/select",
                "type": "field",
                "props": {
                  "options": {
                    "button_square":  { "label": "Square" },
                    "button_rounded": { "label": "Rounded" },
                    "button_circle":  { "label": "Circle" }
                  }
                }
              }
            },
            "columns": {
              "groupSlug": "contentLayout",
              "attrName": "socialShareData.innerContent",
              "subName": "columns",
              "label": "Number of Columns",
              "description": "Choose number of columns.",
              "priority": 30,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "name": "divi/select",
                "type": "field",
                "props": {
                  "options": {
                    "column_auto":  { "label": "Auto" },
                    "column_one":   { "label": "1" },
                    "column_two":   { "label": "2" },
                    "column_three": { "label": "3" },
                    "column_four":  { "label": "4" },
                    "column_five":  { "label": "5" },
                    "column_six":   { "label": "6" }
                  }
                }
              }
            },
            "columns_gap": {
              "groupSlug": "contentLayout",
              "attrName": "socialShareData.innerContent",
              "subName": "columns_gap",
              "label": "Column Gap",
              "priority": 40,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "name": "divi/range",
                "type": "field",
                "props": {
                  "min": 0,
                  "max": 100,
                  "allowedUnits": [
                    "px",
                    "em",
                    "rem",
                    "%"
                  ]
                }
              }
            },
            "row_gap": {
              "groupSlug": "contentLayout",
              "attrName": "socialShareData.innerContent",
              "subName": "row_gap",
              "label": "Row Gap",
              "priority": 50,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "name": "divi/range",
                "type": "field",
                "props": {
                  "min": 0,
                  "max": 100,
                  "allowedUnits": [
                    "px",
                    "em",
                    "rem",
                    "%"
                  ]
                }
              }
            },
            "button_bg": {
              "groupSlug": "designShareButton",
              "attrName": "socialShareData.innerContent",
              "subName": "button_bg",
              "label": "Button Background Color",
              "priority": 10,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "name": "divi/color-picker",
                "type": "field"
              }
            },
            "button_padding": {
              "groupSlug": "designShareButton",
              "attrName": "socialShareData.innerContent",
              "subName": "button_padding",
              "label": "Button Padding",
              "priority": 20,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "name": "divi/spacing",
                "type": "group",
                "props": {
                  "grouped": false,
                  "fieldLabel": "Button Padding"
                }
              }
            },
            "icon_color": {
              "groupSlug": "designShareIcon",
              "attrName": "socialShareData.innerContent",
              "subName": "icon_color",
              "label": "Icon Color",
              "priority": 10,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "name": "divi/color-picker",
                "type": "field"
              }
            },
            "icon_size": {
              "groupSlug": "designShareIcon",
              "attrName": "socialShareData.innerContent",
              "subName": "icon_size",
              "label": "Icon Size",
              "priority": 20,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "name": "divi/range",
                "type": "field",
                "props": {
                  "min": 0,
                  "max": 100,
                  "allowedUnits": [
                    "px"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "customCssFields": {
    "wrapper": {
      "subName": "wrapper",
      "selectorSuffix": " .inftnc_social_share_wrapper"
    },
    "share_link": {
      "subName": "share_link",
      "selectorSuffix": " .inftnc_share_link"
    },
    "social_icon": {
      "subName": "social_icon",
      "selectorSuffix": " .inftnc_social_icon"
    },
    "social_text": {
      "subName": "social_text",
      "selectorSuffix": " .inftnc_social_text"
    }
  },
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentLayout": {
        "panel": "content",
        "priority": 10,
        "groupName": "contentLayout",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Layout"
          }
        }
      },
      "designButtonText": {
        "panel": "design",
        "priority": 10,
        "groupName": "designButtonText",
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Button Text",
            "presetGroup": "divi/font"
          }
        }
      },
      "designShareButton": {
        "panel": "design",
        "priority": 20,
        "groupName": "designShareButton",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Share Button"
          }
        }
      },
      "designShareIcon": {
        "panel": "design",
        "priority": 30,
        "groupName": "designShareIcon",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Share Icon"
          }
        }
      }
    }
  }
}