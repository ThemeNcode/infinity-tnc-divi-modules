{
  "name": "inftnc/type-writer",
  "d4Shortcode": "inftnc_type_writer",
  "title": "Typewriter - Infinity TNC",
  "titles": "Typewriters",
  "moduleIcon": "divi/content",
  "moduleClassName": "inftnc_type_writer",
  "moduleOrderClassName": "inftnc_typewriter_wrapper",
  "category": "module",
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "meta": {
          "adminLabel": {
            "desktop": {
              "value": "Typewriter"
            }
          }
        }
      },
      "settings": {
        "meta": {
          "adminLabel": {}
        },
        "advanced": {
          "link": {},
          "htmlAttributes": {},
          "header": {
            "title": {
              "css": {
                "main": "{{selector}} h1.inftnc_typewriter_main_title, {{selector}} h2.inftnc_typewriter_main_title, {{selector}} h3.inftnc_typewriter_main_title, {{selector}} h4.inftnc_typewriter_main_title, {{selector}} h5.inftnc_typewriter_main_title, {{selector}} h6.inftnc_typewriter_main_title"
              },
              "font_size": { "default": "30px" },
              "line_height": { "default": "1em" },
              "letter_spacing": { "default": "0px" },
              "header_level": { "default": "h1" }
            }
          }
        },
        "decoration": {
          "background": {},
          "sizing": {},
          "spacing": {},
          "border": {},
          "boxShadow": {},
          "transform": {},
          "animation": {},
          "overflow": {},
          "disabledOn": {},
          "transition": {},
          "position": {},
          "zIndex": {},
          "scroll": {},
          "sticky": {}
        }
      }
    },
    "beforeText": {
      "type": "object",
      "label": "Before Title Text",
      "selector": "{{selector}} .inftnc_before_text",
      "default": {
        "decoration": {
          "font": {
            "font": {
              "desktop": {
                "value": {
                  "size": "30px",
                  "lineHeight": "1em"
                }
              }
            }
          }
        }
      },
      "settings": {
        "decoration": {
          "font": {}
        }
      }
    },
    "afterText": {
      "type": "object",
      "label": "After Title Text",
      "selector": "{{selector}} .inftnc_after_text",
      "default": {
        "decoration": {
          "font": {
            "font": {
              "desktop": {
                "value": {
                  "size": "30px",
                  "lineHeight": "1em"
                }
              }
            }
          }
        }
      },
      "settings": {
        "decoration": {
          "font": {}
        }
      }
    },
    "typewriterData": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "innerContent": {
          "desktop": {
            "value": {
              "before_text": "I am a Heading with",
              "typing_text": "Typewriter|Typing Animation",
              "after_text": "Effect",
              "typing_speed": "75",
              "typing_backspeed": "75",
              "pause_for": "1500",
              "typing_cursor": "|",
              "typing_loop": "on"
            }
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "before_text": {
              "groupSlug": "contentTypeWriter",
              "attrName": "typewriterData.innerContent",
              "subName": "before_text",
              "label": "Before Text",
              "description": "Text displayed before the typing animation.",
              "priority": 10,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": { "name": "divi/text", "type": "field" }
            },
            "typing_text": {
              "groupSlug": "contentTypeWriter",
              "attrName": "typewriterData.innerContent",
              "subName": "typing_text",
              "label": "Typing Text",
              "description": "Use | to separate multiple values. Ex. Text 1 | Text 2 | Text 3",
              "priority": 20,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": { "name": "divi/text", "type": "field" }
            },
            "after_text": {
              "groupSlug": "contentTypeWriter",
              "attrName": "typewriterData.innerContent",
              "subName": "after_text",
              "label": "After Text",
              "description": "Text displayed after the typing animation.",
              "priority": 30,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": { "name": "divi/text", "type": "field" }
            },
            "typing_speed": {
              "groupSlug": "typingOptionsTypeWriter",
              "attrName": "typewriterData.innerContent",
              "subName": "typing_speed",
              "label": "Typing Speed (ms)",
              "description": "The speed between typing each character in milliseconds.",
              "priority": 10,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": {
                "name": "divi/range",
                "type": "field",
                "props": { "min": 1, "max": 500, "step": 1, "defaultUnit": "" }
              }
            },
            "typing_backspeed": {
              "groupSlug": "typingOptionsTypeWriter",
              "attrName": "typewriterData.innerContent",
              "subName": "typing_backspeed",
              "label": "Typing BackSpeed (ms)",
              "description": "The speed between deleting each character in milliseconds.",
              "priority": 20,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": {
                "name": "divi/range",
                "type": "field",
                "props": { "min": 1, "max": 500, "step": 1, "defaultUnit": "" }
              }
            },
            "pause_for": {
              "groupSlug": "typingOptionsTypeWriter",
              "attrName": "typewriterData.innerContent",
              "subName": "pause_for",
              "label": "Pause Time (ms)",
              "description": "The pause duration after a text is typed in milliseconds.",
              "priority": 30,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": {
                "name": "divi/range",
                "type": "field",
                "props": { "min": 100, "max": 10000, "step": 100, "defaultUnit": "" }
              }
            },
            "typing_cursor": {
              "groupSlug": "typingOptionsTypeWriter",
              "attrName": "typewriterData.innerContent",
              "subName": "typing_cursor",
              "label": "Cursor Character",
              "description": "The character used as the typing cursor.",
              "priority": 40,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": { "name": "divi/text", "type": "field" }
            },
            "typing_loop": {
              "groupSlug": "typingOptionsTypeWriter",
              "attrName": "typewriterData.innerContent",
              "subName": "typing_loop",
              "label": "Loop",
              "description": "Whether to keep looping the typing animation.",
              "priority": 50,
              "render": true,
              "features": { "sticky": false, "hover": false, "responsive": false },
              "component": {
                "name": "divi/toggle",
                "type": "field",
                "props": {
                  "options": {
                    "off": { "label": "No" },
                    "on":  { "label": "Yes" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "customCssFields": {
    "main_title": {
      "subName": "main_title",
      "selectorSuffix": " .inftnc_typewriter_main_title"
    },
    "before_text": {
      "subName": "before_text",
      "selectorSuffix": " .inftnc_before_text"
    },
    "after_text": {
      "subName": "after_text",
      "selectorSuffix": " .inftnc_after_text"
    }
  },
  "settings": {
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentTypeWriter": {
        "panel": "content",
        "priority": 10,
        "groupName": "contentTypeWriter",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": { "groupLabel": "Text Content" }
        }
      },
      "typingOptionsTypeWriter": {
        "panel": "content",
        "priority": 20,
        "groupName": "typingOptionsTypeWriter",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": { "groupLabel": "Typing Options" }
        }
      }
    }
  }
}
