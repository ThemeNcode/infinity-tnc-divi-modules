{
  "name": "inftnc/bread-crumbs",
  "d4Shortcode": "inftnc_bread_crumbs",
  "title": "Breadcrumbs - Infinity TNC",
  "titles": "Breadcrumbs",
  "moduleIcon": "divi/content",
  "moduleClassName": "inftnc_bread_crumbs",
  "moduleOrderClassName": "inftnc_bread_crumbs_container",
  "category": "module",
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "meta": {
          "adminLabel": {
            "desktop": {
              "value": "Breadcrumbs"
            }
          }
        }
      },
      "settings": {
        "meta": {
          "adminLabel": {}
        },
        "advanced": {
          "link": {},
          "htmlAttributes": {}
        },
        "decoration": {
          "background": {},
          "sizing": {},
          "spacing": {},
          "border": {},
          "boxShadow": {},
          "transform": {},
          "animation": {},
          "overflow": {},
          "disabledOn": {},
          "transition": {},
          "position": {},
          "zIndex": {},
          "scroll": {},
          "sticky": {}
        }
      }
    },
    "breadcrumbText": {
      "type": "object",
      "selector": "{{selector}}, {{selector}} a, {{selector}} .inftnc_current, {{selector}} .inftnc_before",
      "styleProps": {
        "font": {
          "important": true
        }
      },
      "settings": {
        "decoration": {
          "font": {
            "groupType": "group-item",
            "item": {
              "groupSlug": "designBreadcrumbText",
              "attrName": "breadcrumbText.decoration.font",
              "priority": 10,
              "render": true,
              "component": {
                "name": "divi/font",
                "type": "group",
                "props": {
                  "grouped": false,
                  "fieldLabel": "Breadcrumb Text",
                  "fields": {
                    "headingLevel": {
                      "render": false
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "breadCrumbsData": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "innerContent": {
          "desktop": {
            "value": {
              "home_text": "Home",
              "before_text": "",
              "seperator_icon": "&#x35;||divi",
              "use_before_icon": "off",
              "before_text_icon": "&#x35;||divi",
              "link_color": "",
              "seperate_icon_color": "",
              "current_text_color": "",
              "before_text_color": ""
            }
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-items",
          "items": {
            "home_text": {
              "groupSlug": "contentBreadCrumbs",
              "attrName": "breadCrumbsData.innerContent",
              "subName": "home_text",
              "label": "Home Text",
              "description": "Default home text in the Breadcrumbs.",
              "priority": 10,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "name": "divi/text",
                "type": "field"
              }
            },
            "before_text": {
              "groupSlug": "contentBreadCrumbs",
              "attrName": "breadCrumbsData.innerContent",
              "subName": "before_text",
              "label": "Before Text",
              "description": "Text displayed before the breadcrumb trail.",
              "priority": 20,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "name": "divi/text",
                "type": "field"
              }
            },
            "seperator_icon": {
              "groupSlug": "iconBreadCrumbs",
              "attrName": "breadCrumbsData.innerContent",
              "subName": "seperator_icon",
              "label": "Separator Icon",
              "description": "Choose the icon used as the breadcrumb separator.",
              "priority": 10,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "name": "divi/icon-picker",
                "type": "field",
                "props": {
                  "default": "&#x35;||divi"
                }
              }
            },
            "use_before_icon": {
              "groupSlug": "iconBreadCrumbs",
              "attrName": "breadCrumbsData.innerContent",
              "subName": "use_before_icon",
              "label": "Add Before Icon",
              "priority": 20,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "name": "divi/toggle",
                "type": "field",
                "props": {
                  "options": {
                    "off": {
                      "label": "No"
                    },
                    "on": {
                      "label": "Yes"
                    }
                  }
                }
              }
            },
            "before_text_icon": {
              "groupSlug": "iconBreadCrumbs",
              "attrName": "breadCrumbsData.innerContent",
              "subName": "before_text_icon",
              "label": "Before Text Icon",
              "description": "Choose the icon displayed before the breadcrumb trail.",
              "priority": 30,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "name": "divi/icon-picker",
                "type": "field",
                "props": {
                  "default": "&#x35;||divi"
                }
              }
            },
            "link_color": {
              "groupSlug": "colorsBreadCrumbs",
              "attrName": "breadCrumbsData.innerContent",
              "subName": "link_color",
              "label": "Link Color",
              "priority": 10,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "name": "divi/color-picker",
                "type": "field"
              }
            },
            "seperate_icon_color": {
              "groupSlug": "colorsBreadCrumbs",
              "attrName": "breadCrumbsData.innerContent",
              "subName": "seperate_icon_color",
              "label": "Separator Icon Color",
              "priority": 20,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "name": "divi/color-picker",
                "type": "field"
              }
            },
            "current_text_color": {
              "groupSlug": "colorsBreadCrumbs",
              "attrName": "breadCrumbsData.innerContent",
              "subName": "current_text_color",
              "label": "Current Text Color",
              "priority": 30,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "name": "divi/color-picker",
                "type": "field"
              }
            },
            "before_text_color": {
              "groupSlug": "colorsBreadCrumbs",
              "attrName": "breadCrumbsData.innerContent",
              "subName": "before_text_color",
              "label": "Before Text Color",
              "priority": 40,
              "render": true,
              "features": {
                "sticky": false,
                "hover": false,
                "responsive": false
              },
              "component": {
                "name": "divi/color-picker",
                "type": "field"
              }
            }
          }
        }
      }
    }
  },
  "customCssFields": {
    "before_text": {
      "subName": "before_text",
      "selectorSuffix": " .inftnc_before"
    },
    "home_text": {
      "subName": "home_text",
      "selectorSuffix": " .home"
    },
    "seperator": {
      "subName": "seperator",
      "selectorSuffix": " .inftnc_separator"
    },
    "link_text": {
      "subName": "link_text",
      "selectorSuffix": " .inftnc_current"
    }
  },
  "settings": {
    "design": "auto",
    "advanced": "auto",
    "groups": {
      "contentBreadCrumbs": {
        "panel": "content",
        "priority": 10,
        "groupName": "contentBreadCrumbs",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Content"
          }
        }
      },
      "iconBreadCrumbs": {
        "panel": "content",
        "priority": 20,
        "groupName": "iconBreadCrumbs",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Icons"
          }
        }
      },
      "designBreadcrumbText": {
        "panel": "design",
        "priority": 10,
        "groupName": "designBreadcrumbText",
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Breadcrumb Text",
            "presetGroup": "divi/font"
          }
        }
      },
      "colorsBreadCrumbs": {
        "panel": "design",
        "priority": 20,
        "groupName": "colorsBreadCrumbs",
        "multiElements": true,
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Colors"
          }
        }
      }
    }
  }
}